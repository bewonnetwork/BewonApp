rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Sob user-er profile (nam, bhasha, photo) sobai dekhte pare, nijer ta nije likhte pare
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Starred messages: shudhu nijer
      match /starred/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /prefs/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Broadcast list: shudhu nijer
      match /broadcasts/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Chat (direct ba group): shudhu member-ra dekhte/likhte pare
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && request.auth.uid == request.resource.data.from;
        // Nijer message delete (deleted: true) korte pare
        allow update: if signedIn() && (
          request.auth.uid == resource.data.from
          || (isChatMember(chatId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
        );
      }

      // Group call
      match /gcalls/{callId} {
        allow read, write: if isChatMember(chatId);

        match /chat/{id} {
          allow read, create: if isChatMember(chatId);
        }

        match /participants/{uid} {
          allow read: if isChatMember(chatId);
          allow write: if isChatMember(chatId) && request.auth.uid == uid;
        }
        match /signals/{sid} {
          allow read: if isChatMember(chatId) && resource.data.to == request.auth.uid;
          allow create: if isChatMember(chatId) && request.resource.data.from == request.auth.uid;
          allow delete: if isChatMember(chatId) && resource.data.to == request.auth.uid;
        }
      }
    }

    // Status (24 ghonta): sobai dekhe, shudhu malik toiri/delete kore, onno keu shudhu viewedBy-te nijer nam likhte pare
    match /statuses/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
      );
    }

    // Community: shudhu member-ra
    match /communities/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Meeting (code diye): jar kache code ache se-i join korte pare (list kora jay na)
    match /meetings/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /chat/{id} {
        allow read, create: if signedIn();
      }

      match /participants/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /signals/{sid} {
        allow read: if signedIn() && resource.data.to == request.auth.uid;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid;
        allow delete: if signedIn() && resource.data.to == request.auth.uid;
      }
    }

    // 1-to-1 call signaling: shudhu caller ar callee
    match /calls/{callId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow read, update: if signedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /callerCandidates/{id} {
        allow read, write: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
           || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
      match /calleeCandidates/{id} {
        allow read, write: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
           || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
      // Live translate caption
      match /captions/{id} {
        allow read, create: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
           || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }
    }
  }
}
